# Dependencies (none currently, but future-proof)
node_modules/

# Generated theme distributables (BUILD OUTPUT — run `npm run build-themes` to produce).
# Not committed so forks pull upstream updates conflict-free, then rebuild locally.
# (Hand-authored files in themes/ — effects.css, components.css, preview.html, README.md — stay committed.)
themes/theme.css
themes/tokens.json
themes/themes.index.json
themes/theme-init.js
themes/theme-select.js

# Local machine config written by the installer (never committed — keeps paths off the repo)
.theme-service.local.json
*.local.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Local Claude/agent scratch that may land in the repo dir
.claude/

# Build output and local development directories (never commit)
_site/
scratch/

# Full-resolution image sources. The web-optimized derivative is what ships
# (e.g. a11y-way-pages/assets/header-image.webp); keeping the multi-MB original out of git
# stops it bloating every clone. Re-encode with:
#   ffmpeg -i a11y-way-pages/assets/header-image.png -vf "scale=1600:-2:flags=lanczos" \
#          -c:v libwebp -quality 82 -compression_level 6 a11y-way-pages/assets/header-image.webp
a11y-way-pages/assets/header-image.png
